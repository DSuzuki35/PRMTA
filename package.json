{
  "name": "prmta",
  "version": "0.2.0",
  "description": "Local-first teleprompter studio for displays, browsers and VR",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "PRMTA",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "serve": "node dist-server/standalone.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "studio.prmpt.app",
    "productName": "PRMTA",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".tools/whisper",
        "to": "whisper",
        "filter": [
          "Release/**/*",
          "ggml-base.bin"
        ]
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    }
  }
}
